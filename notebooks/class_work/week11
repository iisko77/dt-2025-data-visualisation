).generate_from_text(text).to_image()

def color_function(word, font_size, position, orientation, random_state=None, **additional_args):

   if len(word) < 4:       # If the word has fewer than 4 letters

       return "green"       # color it green

   return "blue"            # Otherwise, color it blue


# Generate a word cloud from the text and recolor it using the custom color function

WordCloud().generate_from_text(text).recolor(color_func=color_function).to_image()
